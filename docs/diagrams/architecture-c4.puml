@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Container view: MY3PAI Governed AI Core (v0.2.0-beta)

LAYOUT_LEFT_RIGHT()

' Real-time revocation cutoff and connector quarantine are the
' differentiating path; accented so reviewers can trace it visually.
AddRelTag("revocation", $textColor="#C0392B", $lineColor="#C0392B")

Person(agent, "Actor + Declared Purpose", "Submits PolicyRequest. Cannot self-authorize.")
Person(custodian, "Custodian Operator", "Registers assets. Triggers withdrawal.")
Person(reviewer, "Human Reviewer", "Resolves REV-* tickets. Trail is tamper-evident.")

System_Ext(authority, "Custodian Mandate Authority", "Signs mandates with HMAC keys, outside the runtime.")
System_Ext(ext_connectors, "External Retrieval Connectors", "CDNs, media stores, tool endpoints.")

System_Boundary(core, "MY3PAI Governed AI Core") {
    Container(api, "HTTP Service", "Python", "POST /evaluate, POST /revoke, GET /health.")
    Container(gateway, "Policy Gateway", "Python", "Out-of-band, fail-closed. Four states: Allowed / Conditional / Blocked / Human Review.")
    Container(records, "Asset Registry", "Python", "Mandate-bound assets. Withdrawal state. Trace.")
    Container(workflows, "Workflow Engine", "Python", "Holding queues. Scoped execution for Allowed runs.")
    Container(connectors, "Connector Registry", "Python", "Synchronous quarantine. Refuse reads until acknowledged.")
    Container(ledger, "Contribution Ledger", "Python", "Integer cents/basis points. ROUND_HALF_EVEN. Exact replay.")
}

Rel(agent, api, "Submits request", "HTTP/JSON")
Rel(custodian, api, "Revokes rights", "HTTP/JSON")
Rel_Down(reviewer, workflows, "Resolves tickets")
Rel_Down(authority, records, "Signs mandates", "HMAC-SHA256")
Rel(api, gateway, "evaluate(request)")
Rel_Down(gateway, records, "Registry checks")
Rel(gateway, workflows, "Four-state routing")
Rel(workflows, ledger, "Settlement")
Rel(records, connectors, "Withdrawal broadcast", $tags="revocation")
Rel(connectors, ext_connectors, "Quarantines", $tags="revocation")

@enduml
