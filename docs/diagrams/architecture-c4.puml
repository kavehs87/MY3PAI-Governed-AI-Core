@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Container view: MY3PAI Governed AI Core (v0.2.0-beta)

LAYOUT_LEFT_RIGHT()
LAYOUT_WITH_LEGEND()

' Real-time revocation cutoff and connector quarantine are the
' differentiating path; accented so reviewers can trace it visually.
AddRelTag("revocation", $textColor="#C0392B", $lineColor="#C0392B")

Person(agent, "Actor + Declared Purpose", "Agent runtime that submits PolicyRequest. Cannot self-authorize or alter permissions.")
Person(custodian, "Custodian Operator", "Registers assets and triggers withdrawal (revocation cutoff).")
Person(reviewer, "Human Reviewer", "Adjudicates the Human Review queue; decisions logged with tamper-evident trail.")

System_Ext(authority, "Custodian Mandate Authority", "Signs asset mandates with HMAC keys outside the runtime boundary.")
System_Ext(ext_connectors, "External Retrieval Connectors", "CDNs, media stores, tool endpoints serving registered assets.")

System_Boundary(core, "MY3PAI Governed AI Core") {
    Container(api, "HTTP Service", "Python", "POST /evaluate, POST /revoke, GET /health. Stdlib HTTP, thread pool, no framework overhead.")
    Container(gateway, "Policy Gateway", "Python", "Out-of-band, fail-closed. Four-state rule engine (Allowed / Conditional / Blocked / Human Review), consent tokens with single-use nonces, injection screen.")
    Container(records, "Asset Registry", "Python", "Mandate-bound AssetMetadata; monotonic withdrawal state; revocation listeners; hash-chained execution trace.")
    Container(workflows, "Workflow Engine", "Python", "Holding queues for Conditional and Human Review; scoped execution for Allowed runs.")
    Container(connectors, "Connector Registry", "Python", "Synchronous quarantine propagation; refuse reads until acknowledged.")
    Container(ledger, "Contribution Ledger", "Python", "Integer cents and basis points; ROUND_HALF_EVEN; byte-identical replay.")
}

Rel(agent, api, "Submits PolicyRequest", "HTTP/JSON")
Rel(custodian, api, "Revokes asset rights", "HTTP/JSON")
Rel(reviewer, workflows, "Resolves REV-* tickets")
Rel(authority, records, "Signs mandates", "HMAC-SHA256")
Rel(api, gateway, "evaluate(request)")
Rel(gateway, records, "Registry checks")
Rel(gateway, workflows, "Four-state routing")
Rel(workflows, ledger, "Settlement from execution traces")
Rel(records, connectors, "Withdrawal broadcast", $tags="revocation")
Rel(connectors, ext_connectors, "Quarantines", $tags="revocation")

@enduml
